      <column caption='Profit Margin KPI' datatype='real' name='[Calculation_1219126501396482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Gross_Profit_SAR]) / SUM([Service_Revenue_SAR])' />
      </column>
      <column caption='Claim Collection Rate %' datatype='real' name='[Calculation_1299116675432449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Paid_Amount_SAR]) / SUM([Submitted_Amount_SAR])' />
      </column>
      <column caption='Survey Responses' datatype='integer' name='[Calculation_1299116698329092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Survey_ID])' />
      </column>
      <column caption='Satisfaction Within Target %' datatype='real' name='[Calculation_1299116698931205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Satisfaction_Within_Target_Flag])&#13;&#10;/&#13;&#10;COUNT([Encounter_ID])' />
      </column>
      <column caption='Positive Outcome Rate' datatype='real' name='[Calculation_1299116699828230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Outcome] = &quot;Recovered&quot;&#13;&#10;    OR [Outcome] = &quot;Improved&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([Encounter_ID])' />
      </column>
      <column caption='Low Satisfaction Rate' datatype='real' name='[Calculation_1299116700524551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Patient_Satisfaction_Score] &lt; 4.5&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([Encounter_ID])' />
      </column>
      <column caption='Survey Coverage Rate' datatype='real' name='[Calculation_1299116701650952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Survey_ID]) / 30000' />
      </column>
      <column caption='Satisfaction Rating Band' datatype='string' name='[Calculation_1299116704391177]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Patient_Satisfaction_Score] &lt; 3.0 THEN &quot;Below 3.0&quot;&#13;&#10;ELSEIF [Patient_Satisfaction_Score] &lt; 3.5 THEN &quot;3.0–3.4&quot;&#13;&#10;ELSEIF [Patient_Satisfaction_Score] &lt; 4.0 THEN &quot;3.5–3.9&quot;&#13;&#10;ELSEIF [Patient_Satisfaction_Score] &lt; 4.5 THEN &quot;4.0–4.4&quot;&#13;&#10;ELSE &quot;4.5–5.0&quot;&#13;&#10;END' />
      </column>
      <column caption='Readmission Rate' datatype='real' name='[Calculation_1299116710019082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Readmission_Flag]) / COUNT([Encounter_ID])' />
      </column>
      <column caption='Avg Encounters per Physician' datatype='real' name='[Calculation_1299116715716619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Encounter_ID]) / COUNTD([Physician_ID])' />
      </column>
      <column caption='Avg Revenue per Physician' datatype='real' name='[Calculation_1299116716675084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Service_Revenue_SAR]) / COUNTD([Physician_ID])' />
      </column>
      <column caption='Avg Service Time per Encounter' datatype='real' name='[Calculation_1299116717477901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Service_Time_Minutes]) / COUNTD([Encounter_ID])' />
      </column>
      <column caption='Revenue per Treatment Minute' datatype='real' name='[Calculation_1299116718133262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Service_Revenue_SAR]) / SUM([Treatment_Time_Minutes])' />
      </column>
